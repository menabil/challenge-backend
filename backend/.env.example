# Server
PORT=5000

# ---------- MongoDB ----------
# Username, Password, Database Name আলাদাভাবে দিন, db.js এগুলো দিয়ে connection string বানিয়ে নেবে
MONGODB_USERNAME=""
MONGODB_PASSWORD=""
MONGODB_DBNAME=""

# যদি MongoDB Atlas ব্যবহার করেন, cluster address এখানে দিন
# (যেমন: cluster0.abcde.mongodb.net) - এটা দিলে Atlas connection string বানবে
# খালি রাখলে Local MongoDB (localhost:27017) এর সাথে connect করবে
MONGODB_CLUSTER=""

# ---------- Cloudinary (Medical Report Image Upload) ----------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------- Email (Nodemailer - Gmail example) ----------
# Gmail e "App Password" use korte hobe, normal password diye kaj korbe na
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="Doctor Appointment System <your_email@gmail.com>"

# ---------- Frontend ----------
CLIENT_URL=http://localhost:5173
